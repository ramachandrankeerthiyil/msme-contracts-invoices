# Copy to .env and fill in. Never commit .env.

# PostgreSQL (admin user — used only by the db container to initialise schemas)
POSTGRES_USER=msme
POSTGRES_PASSWORD=change-me
POSTGRES_DB=msme

# One DB login per service; each owns only its own schema
INVOICE_DB_PASSWORD=change-me-invoice
CONTRACT_DB_PASSWORD=change-me-contract

# Contract extraction (Claude API) — see specs/decisions/0002-llm-contract-extraction.md
ANTHROPIC_API_KEY=
CONTRACT_LLM_MODEL=claude-sonnet-5
# low | medium | high | xhigh | max  (lower = cheaper, less thorough)
CONTRACT_LLM_EFFORT=high

# "Talk to Me" assistant (same Claude key) — see specs/decisions/0003-conversational-assistant.md
# claude = real answers; fake = scripted answers with no API calls (tests, demos)
ASSISTANT_LLM=claude
ASSISTANT_LLM_MODEL=claude-sonnet-5
# low | medium | high | xhigh | max  (medium keeps answers quick)
ASSISTANT_LLM_EFFORT=medium
# A small, fast model checks every question before the main one and declines anything that is not
# about contracts, invoices or this app — see specs/decisions/0005-assistant-guardrails.md
ASSISTANT_GUARD_MODEL=claude-haiku-4-5-20251001

# Payment reminder emails (INV-004) — see specs/decisions/0004-email-reminders.md
# Defaults send to the local Mailpit inbox at http://localhost:8025, so nothing reaches a real
# client. To send real emails, point these at your mail provider (and use an address you own).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
# true for providers on port 587 (Gmail, Outlook, SendGrid, ...)
SMTP_STARTTLS=false
SMTP_FROM_ADDRESS=accounts@msme-poc.local
REMINDER_SENDER_NAME=Accounts Team
SMTP_TIMEOUT_SECONDS=10

# Access password (PLT-003). The app has no user accounts, so a public address MUST have this set.
# Empty = no password (fine on your own machine). At least 12 characters; make one with:
#   openssl rand -base64 18
# Then run scripts/tunnel.sh to get a public Cloudflare address. It refuses to start without this.
ACCESS_USERNAME=user
ACCESS_PASSWORD=

# Business rules (defaults match the specs)
APP_TIMEZONE=Asia/Kolkata
INVOICE_AT_RISK_DAYS=5
CONTRACT_AT_RISK_DAYS=3

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Grafana (only with: docker compose --profile observability up)
GRAFANA_ADMIN_PASSWORD=change-me-grafana
GRAFANA_PORT=3001
