# Copy to .env and fill in. Never commit .env.

# PostgreSQL (admin user — used only by the db container to initialise schemas)
POSTGRES_USER=msme
POSTGRES_PASSWORD=change-me
POSTGRES_DB=msme

# One DB login per service; each owns only its own schema
INVOICE_DB_PASSWORD=change-me-invoice
CONTRACT_DB_PASSWORD=change-me-contract

# Contract extraction (Claude API) — see specs/decisions/0002-llm-contract-extraction.md
ANTHROPIC_API_KEY=
CONTRACT_LLM_MODEL=claude-sonnet-5
# low | medium | high | xhigh | max  (lower = cheaper, less thorough)
CONTRACT_LLM_EFFORT=high

# Business rules (defaults match the specs)
APP_TIMEZONE=Asia/Kolkata
INVOICE_AT_RISK_DAYS=5
CONTRACT_AT_RISK_DAYS=3

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Grafana (only with: docker compose --profile observability up)
GRAFANA_ADMIN_PASSWORD=change-me-grafana
GRAFANA_PORT=3001
