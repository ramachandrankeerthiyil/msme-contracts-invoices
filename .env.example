# Copy to .env and fill in. Never commit .env.

# PostgreSQL
POSTGRES_USER=msme
POSTGRES_PASSWORD=change-me
POSTGRES_DB=msme
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Contract extraction (Claude API)
ANTHROPIC_API_KEY=
CONTRACT_LLM_MODEL=claude-sonnet-5

# Business rules (defaults match the specs)
APP_TIMEZONE=Asia/Kolkata
INVOICE_AT_RISK_DAYS=5
CONTRACT_AT_RISK_DAYS=3

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
